# Googolf 환경변수 목록. 값은 절대 커밋하지 않는다(.env.local은 gitignore).
# 로컬 값은 `pnpm exec supabase status -o env`로 확인한다.
# 규칙: 서버 전용 비밀값에 NEXT_PUBLIC_ 접두사 금지. lib/env.ts(M2)가 zod로 검증한다.

# ── 공개(브라우저 노출 가능) ─────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable(anon) 키. RLS가 보호하므로 공개돼도 된다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 서버 전용 ─────────────────────────────────────────
# service_role 키: RLS를 우회한다. lib/supabase/admin.ts에서만 사용(server-only).
SUPABASE_SERVICE_ROLE_KEY=
# 스크립트(동시성 테스트, 시드)용 직접 DB 접속
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# 카카오 OAuth(고객 로그인, M2). supabase/config.toml에서 env()로 참조한다.
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_KAKAO_SECRET=

# 최초 owner 계정 시드(M2, scripts/seed-owner.ts)
OWNER_EMAIL=

# E2E(Playwright): 브라우저가 미리 설치된 환경에서만 실행 파일 경로 지정(예: /opt/pw-browsers/chromium. 컨테이너마다 chromium-NNNN 폴더 버전이 달라 ls /opt/pw-browsers로 확인)
PW_CHROMIUM_PATH=

# Sentry — 후순위 보류(D-34). 재개 시 사용
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# 알림(M6, D-63). 아래 4개는 Vercel이 아니라 Supabase Edge Function 비밀값(Dashboard → Edge Functions → Secrets)이다.
# 로컬에서는 `pnpm notify:dispatch`가 이 파일(.env.local)의 값을 읽는다.
NOTIFY_CUSTOMER_PROVIDER=console   # 고객 알림톡·SMS 대행사. 무료 단계는 console(로그만). 계약 후 어댑터 추가
SLACK_WEBHOOK_URL=                 # 운영자 알림(Slack/Discord Incoming Webhook). 비우면 console
NOTIFY_SITE_URL=                   # 알림 본문 링크의 기준 URL(운영: https://golf-lac-delta.vercel.app)
NOTIFY_DISPATCH_SECRET=            # pg_cron → Edge Function 호출 공유 비밀. Vault의 notify_dispatch_secret과 같은 값

# 유료 전환 시(출시 전 체크리스트 참고)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PFID=
SOLAPI_SENDER_NUMBER=
