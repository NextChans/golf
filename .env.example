# Googolf 환경변수 목록. 값은 절대 커밋하지 않는다(.env.local은 gitignore).
# 로컬 값은 `pnpm exec supabase status -o env`로 확인한다.
# 규칙: 서버 전용 비밀값에 NEXT_PUBLIC_ 접두사 금지. lib/env.ts(M2)가 zod로 검증한다.

# ── 공개(브라우저 노출 가능) ─────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable(anon) 키. RLS가 보호하므로 공개돼도 된다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 서버 전용 ─────────────────────────────────────────
# service_role 키: RLS를 우회한다. lib/supabase/admin.ts에서만 사용(server-only).
SUPABASE_SERVICE_ROLE_KEY=
# 스크립트(동시성 테스트, 시드)용 직접 DB 접속
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# 카카오 OAuth(고객 로그인, M2). supabase/config.toml에서 env()로 참조한다.
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_KAKAO_SECRET=

# 최초 owner 계정 시드(M2, scripts/seed-owner.ts)
OWNER_EMAIL=

# E2E(Playwright): 브라우저가 미리 설치된 환경에서만 실행 파일 경로 지정(예: /opt/pw-browsers/chromium-1194/chrome-linux/chrome)
PW_CHROMIUM_PATH=

# Sentry — 후순위 보류(D-34). 재개 시 사용
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# 알림(M6). 무료 단계에서는 console + slack만 사용한다.
NOTIFY_ADAPTER=console          # console | solapi
SLACK_WEBHOOK_URL=
# outbox 발송 Edge Function 호출용 공유 비밀(pg_cron → Edge Function)
OUTBOX_DISPATCH_SECRET=

# 유료 전환 시(출시 전 체크리스트 참고)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PFID=
SOLAPI_SENDER_NUMBER=
